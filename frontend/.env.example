# Copy to `.env.development.local` for local dev (gitignored).
# Do NOT copy to `.env.local` — that file is also read by `next build` and
# would leak host-specific values (like a VM IP) into the production bundle.
# `.env.production` lives in the repo and already targets `/api` for prod.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api
NEXT_PUBLIC_WOMPI_PUBLIC_KEY=pub_test_...
PLAYWRIGHT_BASE_URL=http://localhost:3000
