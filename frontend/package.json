{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && rm -rf ../backend/templates && mv out ../backend/templates",
    "start": "next start",
    "lint": "eslint",
    "test": "NODE_OPTIONS=--no-deprecation jest",
    "test:watch": "NODE_OPTIONS=--no-deprecation jest --watch",
    "test:ci": "NODE_OPTIONS=--no-deprecation jest --ci",
    "test:coverage": "NODE_OPTIONS=--no-deprecation jest --coverage --colors",
    "e2e": "playwright test",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "e2e:coverage": "FORCE_COLOR=true playwright test",
    "e2e:clean": "rm -rf test-results playwright-report coverage-e2e .nyc_output blob-report monocart-report",
    "check:e2e-flow-sync": "node scripts/check-flow-definitions-sync.mjs",
    "ci:e2e-flow-summary": "node scripts/report-e2e-flow-coverage-ci.mjs"
  },
  "dependencies": {
    "@types/react-google-recaptcha": "^2.1.9",
    "axios": "^1.15.2",
    "clsx": "^2.1.1",
    "framer-motion": "^12.38.0",
    "gsap": "^3.15.0",
    "js-cookie": "^3.0.5",
    "lucide-react": "^0.577.0",
    "next": "16.2.4",
    "next-intl": "^4.11.0",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "react-google-recaptcha": "^3.1.0",
    "swiper": "^12.1.4",
    "tailwind-merge": "^3.5.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.3.0",
    "monocart-reporter": "^2.10.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
