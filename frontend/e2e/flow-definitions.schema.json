{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Flow Coverage Definitions",
  "type": "object",
  "additionalProperties": false,
  "required": ["flows"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "lastUpdated": {
      "type": "string"
    },
    "documentation": {
      "type": "string"
    },
    "flows": {
      "type": "object",
      "minProperties": 1,
      "description": "Object map keyed by flow id (matches the runtime shape consumed by e2e/reporters/flow-coverage-reporter.mjs). The key is the flow id.",
      "propertyNames": {
        "pattern": "^[a-z0-9-]+$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "module", "priority", "roles", "description"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "module": {
            "type": "string",
            "minLength": 1
          },
          "priority": {
            "type": "string",
            "enum": ["P1", "P2", "P3", "P4"]
          },
          "roles": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "coverage": {
            "type": "string",
            "enum": ["missing", "partial", "covered"]
          }
        }
      }
    }
  }
}
